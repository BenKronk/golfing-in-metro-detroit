# ============================================================
# Golf Course 15-Mile Hotspot Analysis
# Metro Detroit Tri-County (Wayne / Oakland / Macomb)
# ============================================================
# Dependencies: geosphere, dplyr, readr
# Install once: install.packages(c("geosphere","dplyr","readr"))
# ============================================================
library(geosphere)
library(dplyr)
library(readr)
# ---- 1. LOAD YOUR COURSE COORDINATES ----------------------
# Point this at your consolidated coordinate file.
# Required columns: course_name, latitude, longitude
# Optional: county, type (use to filter public-only below)
setwd("C:/Users/kronk/OneDrive/Desktop/GOLF")  # <-- update path as needed
courses <- read_csv("C:/Users/kronk/OneDrive/Desktop/GOLF/rebuilt.csv")  # <-- update path as needed
# ============================================================
# Golf Course 15-Mile Hotspot Analysis
# Metro Detroit Tri-County (Wayne / Oakland / Macomb)
# ============================================================
# Dependencies: geosphere, dplyr, readr
# Install once: install.packages(c("geosphere","dplyr","readr"))
# ============================================================
library(geosphere)
library(dplyr)
library(readr)
# ---- 1. LOAD YOUR COURSE COORDINATES ----------------------
# Point this at your consolidated coordinate file.
# Required columns: course_name, latitude, longitude
# Optional: county, type (use to filter public-only below)
setwd("C:/Users/kronk/OneDrive/Desktop/GOLF")  # <-- update path as needed
courses <- read_csv("C:/Users/kronk/OneDrive/Desktop/GOLF/rebuilt.csv")  # <-- update path as needed
# Optional: filter to public-only courses
# Comment this out if you want all courses including private
# courses <- courses %>% filter(!grepl("Private", type, ignore.case = TRUE))
# Drop any rows with missing coordinates
courses <- courses %>% filter(!is.na(latitude), !is.na(longitude))
cat("Courses loaded:", nrow(courses), "\n")
# ---- 2. DEFINE TRI-COUNTY BOUNDING BOX --------------------
# Covers Wayne, Oakland, Macomb with a small buffer
lat_min <- 42.00
lat_max <- 43.05
lon_min <- -84.00
lon_max <- -82.70
# Grid resolution: 0.05 degrees ~ 3.5 miles N-S, ~2.7 miles E-W
# Tighten to 0.025 for higher resolution (slower); loosen to 0.1 for a quick pass
grid_step <- 0.05
# ---- 3. BUILD CANDIDATE GRID ------------------------------
lat_seq <- seq(lat_min, lat_max, by = grid_step)
lon_seq <- seq(lon_min, lon_max, by = grid_step)
grid <- expand.grid(latitude = lat_seq, longitude = lon_seq)
cat("Grid points:", nrow(grid), "\n")
# ---- 4. HAVERSINE DISTANCE & COURSE COUNT -----------------
MILES_15 <- 15 * 1609.344  # convert 15 miles to meters
count_courses <- function(home_lat, home_lon) {
# distHaversine expects (lon, lat) order — note the swap
dists <- distHaversine(
p1 = c(home_lon, home_lat),
p2 = cbind(courses$longitude, courses$latitude)
)
within <- dists <= MILES_15
count  <- sum(within)
names  <- paste(courses$course_name[within], collapse = " | ")
return(c(count = count, course_list = names))
}
cat("Running grid search...\n")
results <- mapply(
FUN      = count_courses,
home_lat = grid$latitude,
home_lon = grid$longitude,
SIMPLIFY = FALSE
)
grid$course_count <- sapply(results, function(x) as.integer(x["count"]))
grid$course_list  <- sapply(results, function(x) x["course_list"])
cat("Done.\n")
# ---- 5. RESULTS -------------------------------------------
# Top 25 grid points by course count
top25 <- grid %>%
arrange(desc(course_count)) %>%
slice_head(n = 25)
cat("\nTop 25 locations by course count:\n")
print(top25 %>% select(latitude, longitude, course_count))
# ---- 6. WRITE OUTPUT CSVs ---------------------------------
# Full grid (use for Tableau heat map)
write_csv(grid, "golf_hotspot_grid.csv")
# Top 25 only (easier to inspect)
write_csv(top25, "golf_hotspot_top25.csv")
cat("\nOutputs written:\n")
cat("  golf_hotspot_grid.csv  — full grid for Tableau\n")
cat("  golf_hotspot_top25.csv — top 25 locations\n")
# ---- 7. QUICK SANITY PLOT (base R, no ggplot needed) ------
# Produces a rough heat map in your R plot window
color_ramp <- colorRampPalette(c("white", "lightgreen", "darkgreen"))
max_count  <- max(grid$course_count)
colors     <- color_ramp(max_count + 1)[grid$course_count + 1]
plot(
x    = grid$longitude,
y    = grid$latitude,
col  = colors,
pch  = 15,       # filled square
cex  = 0.6,
xlab = "Longitude",
ylab = "Latitude",
main = "Golf Courses Within 15 Miles — Metro Detroit Tri-County"
)
# Overlay course locations as black dots
points(
x   = courses$longitude,
y   = courses$latitude,
pch = 19,
cex = 0.4,
col = "black"
)
legend(
"bottomright",
legend = c(paste("Max:", max_count, "courses"), "Course location"),
col    = c("darkgreen", "black"),
pch    = c(15, 19),
pt.cex = c(1, 0.6),
bty    = "n"
)
# ============================================================
