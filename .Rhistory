# ============================================================
# INTERACTIVE VERSION (real street tiles, pan/zoom, popups)
# The most "accessible to a viewer" option — they can find
# their own neighborhood. Uncomment to use.
# ============================================================
# library(leaflet)
# pal <- colorNumeric("magma", domain = grid$course_count, reverse = TRUE)
# leaflet(grid) %>%
#   addProviderTiles("CartoDB.Positron") %>%
#   addRectangles(
#     lng1 = ~longitude - 0.025, lat1 = ~latitude - 0.025,
#     lng2 = ~longitude + 0.025, lat2 = ~latitude + 0.025,
#     fillColor = ~pal(course_count), fillOpacity = 0.55,
#     stroke = FALSE, label = ~paste(course_count, "courses within 15 mi")
#   ) %>%
#   addCircleMarkers(
#     data = courses, ~longitude, ~latitude,
#     radius = 3, color = "black", fillColor = "white",
#     fillOpacity = 1, stroke = TRUE, weight = 1,
#     popup = ~course_name
#   ) %>%
#   addLegend(pal = pal, values = grid$course_count,
#             title = "Courses within 15 mi", position = "bottomright")
library(sf); library(dplyr); library(tigris)
options(tigris_use_cache = TRUE)
# The winner is usually a TIE across several adjacent cells, so grab the
# top cluster, not just one point — that's why the question is "city or cities."
best <- grid %>% filter(course_count >= max(course_count) - 1)
best_sf <- st_as_sf(best, coords = c("longitude","latitude"),
crs = 4326, remove = FALSE)
# Incorporated cities/villages...
places_mi <- places("MI", cb = TRUE, year = 2022) %>% st_transform(4326)
# ...AND townships, which is the part people miss (see below)
subs_mi <- county_subdivisions("MI", county = c("Wayne","Oakland","Macomb"),
cb = TRUE, year = 2022) %>% st_transform(4326)
best_named <- best_sf %>%
st_join(select(places_mi, place = NAME)) %>%
st_join(select(subs_mi, township = NAME)) %>%
st_drop_geometry() %>%
mutate(municipality = coalesce(place, township))
# Your answer: the unique municipalities in the best cluster
best_named %>%
count(municipality, sort = TRUE)
library(tidygeocoder)
best1 <- grid[which.max(grid$course_count), ]
reverse_geocode(tibble::tibble(lat = best1$latitude, long = best1$longitude),
lat = lat, long = long, method = "osm", full_results = TRUE)
best1
